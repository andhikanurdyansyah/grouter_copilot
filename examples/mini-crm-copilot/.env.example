# .env.example — salin ke .env lalu isi. (.env gitignored — lihat CONTRACT)
# Semua nilai di bawah TIDAK ada nilai nyata/rahasia.

# Token lisensi demo (mint via install / license server). Kosong di contoh.
GROUTER_LICENSE=

# License server gRouter Copilot.
GROUTER_LICENSE_SERVER=https://copilot.grouter.id

# Endpoint Copilot backend gateway (D-021: app memanggil gateway, bukan provider).
GROUTER_GATEWAY_URL=https://copilot.grouter.id/api/copilot/chat

# Public verifier key (Ed25519, format PEM, \n-escaped). Kosong di contoh —
# diisi output dari `grouter-copilot install`. TANPA nilai nyata.
GROUTER_LICENSE_PUBLIC_KEY=
