{
  "name": "@grouter/copilot",
  "version": "0.1.0",
  "description": "License-based AI copilot plugin for Node.js apps with developer-defined data skills.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./widget": "./src/widget/CopilotChat.jsx",
    "./config": "./src/config.js",
    "./skills": "./src/skills/registry.js"
  },
  "bin": {
    "grouter-copilot": "./bin/grouter-copilot.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "NODE_ENV=test node --test \"test/**/*.test.js\"",
    "test:server": "cd server && NODE_ENV=test node --test",
    "e2e": "bash scripts/run-e2e.sh",
    "smoke:live": "bash scripts/e2e-smoke-live.sh",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "audit:dependencies:check": "node scripts/dependency-audit.mjs --check"
  },
  "keywords": [
    "grouter",
    "copilot",
    "ai",
    "chatbot",
    "plugin",
    "skills",
    "nextjs",
    "node"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
