# gRouter Copilot server — environment reference (copy to .env, fill real values)

# --- License keypair (stable, generate once) ---
# Leave empty to auto-load from server/data/keys/ (persisted files)
# LICENSE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----
# LICENSE_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----

# --- Admin auth (Bearer token for issue/revoke/bind/usage) ---
# REQUIRED in production. Generate: openssl rand -hex 24
# When empty, admin endpoints fall back to "no auth" (dev only).
ADMIN_TOKEN=

# --- Server ---
PORT=4600
FRONTEND_PORT=4601
# Backend reachable by the frontend proxy
BACKEND_URL=http://127.0.0.1:4600

# --- Public origins ---
FRONTEND_URL=https://copilot.grouter.id

# --- gRouter (read-only supplier) ---
GROUTER_CHECK_USAGE_URL=https://prod.grouter.web.id/api/check-usage

# --- KlikQRIS payment ---
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
# sandbox | production
KLIKQRIS_MODE=sandbox

# --- Better Auth ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://be.grouter.id
# dash() + sentinel() keys from @better-auth/infra (better-auth.com dashboard)
BETTER_AUTH_API_KEY=
# Infra API base (default https://dash.better-auth.com)
BETTER_AUTH_API_URL=https://dash.better-auth.com
# Infra KV/identify base — MUST be the base URL, NOT /projects/<id>.
# The /projects/<id> URL is the dashboard settings page, not an API base;
# using it makes the plugin append paths to it and get 404s.
BETTER_AUTH_KV_URL=https://kv.better-auth.com
# Real client IP header forwarded by the proxy (Cloudflare => cf-connecting-ip)
BETTER_AUTH_CLIENT_IP_HEADER=cf-connecting-ip
# Cross-subdomain cookie scope (shared auth cookie across subdomains).
# Auto-derived from BETTER_AUTH_URL (registrable domain) when empty;
# set explicitly to override, or 'skip' behavior on localhost/IP is automatic.
BETTER_AUTH_COOKIE_DOMAIN=
# Comma-separated allowed origins (frontend origin MUST be listed)
BETTER_AUTH_TRUSTED_ORIGINS=https://copilot.grouter.id,https://be.grouter.id

# --- Google OAuth (optional; button is hidden until BOTH are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth DB (optional; default server/data/auth.sqlite) ---
# AUTH_DB_FILE=
