# gRouter Copilot server — environment reference (copy to .env, fill real values)

# --- License keypair (stable, generate once) ---
# Leave empty to auto-load from server/data/keys/ (persisted files)
# LICENSE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----
# LICENSE_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----

# --- Admin auth (Bearer token for issue/revoke/bind/usage) ---
ADMIN_TOKEN=change-me

# --- Server ---
PORT=4600

# --- gRouter (read-only supplier) ---
GROUTER_CHECK_USAGE_URL=https://prod.grouter.web.id/api/check-usage

# --- KlikQRIS payment ---
KLIKQRIS_API_KEY=
KLIKQRIS_MERCHANT_ID=
KLIKQRIS_MODE=sandbox

# --- Better Auth ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://be.grouter.id
BETTER_AUTH_API_KEY=

# --- Auth DB (optional; default server/data/auth.sqlite) ---
# AUTH_DB_FILE=
